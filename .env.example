# Copiar este archivo como ".env" en la raíz del proyecto y completar los valores reales.
# En Render, estas mismas claves se configuran como variables de entorno del servicio (no se sube este archivo).

# Servidor Express (backend/bin/www)
PORT=8000
NODE_ENV=development
SESSION_SECRET=reemplazar-por-una-clave-larga-y-aleatoria

# Base de datos MySQL (backend/config/database.js)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=app-db
MYSQL_USER=cimino
MYSQL_PASSWORD=reemplazar

# Sentry (backend/instrument.js) - DSN del proyecto en sentry.io
SENTRY_DSN=

# URL del frontend desplegado (Netlify), usada para restringir CORS en producción
FRONTEND_URL=
